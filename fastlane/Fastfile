default_platform(:ios)

platform :ios do

  desc "Build and upload to TestFlight, then submit for App Store review"
  lane :submit do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id:       ENV["ASC_KEY_ID"],
      issuer_id:    ENV["ASC_ISSUER_ID"],
      key_content:  ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: true
    )

    # Generate Xcode project from project.yml
    sh("xcodegen generate --spec ../project.yml")

    # Build
    build_app(
      scheme:              "LynQ",
      workspace:           nil,
      project:             "LynQ.xcodeproj",
      configuration:       "Release",
      output_directory:    "./build",
      output_name:         "LynQ.ipa",
      export_method:       "app-store",
      xcargs:              "DEVELOPMENT_TEAM=#{ENV["DEVELOPMENT_TEAM"]} ANTHROPIC_API_KEY=#{ENV["ANTHROPIC_API_KEY"]}",
      clean:               true
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key:                api_key,
      ipa:                    "./build/LynQ.ipa",
      skip_waiting_for_build_processing: false,
      distribute_external:    false
    )

    # Set App Store metadata
    deliver(
      api_key:                  api_key,
      ipa:                      "./build/LynQ.ipa",
      app_identifier:           "com.lynq.app",
      name:                     "LynQ - AI QR Scanner & Safety",
      description:              {
        "en-US" => File.read("app_store/description_en.txt"),
        "ja"    => File.read("app_store/description_ja.txt")
      },
      keywords:                 {
        "en-US" => "qr scanner,qr reader,barcode scan,ai qr,safe scan,qr generator,phishing,qr code",
        "ja"    => "QRコード,QRスキャナー,QR読み取り,バーコード,QR作成,安全確認,フィッシング対策,QRリーダー"
      },
      release_notes:            {
        "en-US" => File.read("app_store/whats_new_en.txt"),
        "ja"    => File.read("app_store/whats_new_ja.txt")
      },
      primary_category:         "UTILITIES",
      secondary_category:       "PRODUCTIVITY",
      privacy_url:              "https://github.com/Koki-coder-crypto/LynQ_backend/blob/master/app_store/privacy_policy.html",
      support_url:              "https://github.com/Koki-coder-crypto/LynQ_backend/issues",
      price_tier:               0,
      submission_information:   {
        export_compliance_uses_encryption:            false,
        export_compliance_is_exempt:                  true,
        add_id_info_uses_idfa:                        false,
        add_id_info_serves_ads:                       false,
        add_id_info_tracks_action:                    false,
        add_id_info_tracks_install:                   false,
        add_id_info_limits_tracking:                  true,
        content_rights_has_rights:                    true,
        content_rights_contains_third_party_content:  false
      },
      submit_for_review:        true,
      automatic_release:        false,
      skip_screenshots:         true,
      skip_metadata:            false,
      force:                    true
    )

    UI.success("LynQ submitted for App Store review!")
  end

  desc "Build only (no upload)"
  lane :build_only do
    sh("xcodegen generate --spec ../project.yml")
    build_app(
      scheme:        "LynQ",
      project:       "LynQ.xcodeproj",
      configuration: "Release",
      output_directory: "./build",
      output_name:   "LynQ.ipa",
      export_method: "app-store",
      xcargs:        "DEVELOPMENT_TEAM=#{ENV["DEVELOPMENT_TEAM"]} ANTHROPIC_API_KEY=#{ENV["ANTHROPIC_API_KEY"]}",
      clean: true
    )
  end

end
